generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  IN_ACTIVE
}

model User {
  id            String      @id @default(cuid())
  firstName     String
  lastName      String
  email         String      @unique
  role          AllRole
  password      String
  emailVerified Boolean     @default(false)
  status        UserStatus  @default(ACTIVE)

  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // CEOs can have no branch, but others should have one
  branchId      String?
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  subscription  Subscription?

  payments      Payment[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

}

model Company {
  id        String   @id @default(uuid())
  name      String?
  users     User[]
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  location  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users     User[]
  products  Product[]
  expenses  Expense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StaffRole {
  CO_CEO
  GENERAL_MANAGER
  GENERAL_ACCOUNTANT
  MANAGER
  ACCOUNTANT
  SALES_PERSON
}

enum AllRole {
  CEO
  CO_CEO
  GENERAL_MANAGER
  GENERAL_ACCOUNTANT
  MANAGER
  ACCOUNTANT
  SALES_PERSON
}

enum MainRole {
  CEO
  CO_CEO
  MANAGER
}

enum NotificationType {
  USER
  PRODUCT
  EXPENSE
  INVOICE
}

model Notification {
  id            String   @id @default(cuid())
  title         String
  description   String
  type          NotificationType
  companyId     String
  branchId      String?
  userId        String
  role          AllRole

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserNotification {
  id              String   @id @default(cuid())
  userId          String
  role            AllRole 
  companyId       String
  branchId       String?
  readAll          Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum productStatus {
  IN_STOCK          
  OUT_OF_STOCK      
  LOW_STOCK         
}

enum receiptStatus {
  PREORDER          // Not yet available, but can be ordered
  BACKORDER         // Temporarily unavailable, order accepted but fulfilled later
  DAMAGED           // Not sellable due to damage/defect
  RESERVED          // Set aside for a specific customer/order
}

model Product {
  id                String        @id @default(cuid())
  productName       String
  productDesc       String?
  price             Decimal       @db.Decimal(18, 2)
  quantity          Int
  status            productStatus @default(IN_STOCK)
  category          String        @default("uncategorized")
  brand             String        @default("uncategorized")
  companyId         String
  addedBy           String
  role              AllRole
  currentlyEditedBy String
  editedRole        AllRole

  branchId          String?
  branch            Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  SaleItems         SaleItem[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  SPLIT
}

enum SaleStatus {
  CORRECTED
  PAID
  REFUNDED
}

model Sale {
  id                  String   @id @default(cuid())
  companyId           String
  branchId            String?
  sellerEmail         String
  role                AllRole
  receiptNo           Int      @unique
  subtotal            Decimal  @db.Decimal(18, 2) // sum before discount/tax
  discount            Decimal  @db.Decimal(18, 2) @default(0) // flat discount
  tax                 Decimal  @db.Decimal(18, 2) @default(0) // added tax
  totalAmount         Decimal  @db.Decimal(18, 2) // final total after discount/tax
  paymentType         PaymentMethod
  status              SaleStatus  @default(PAID)
  correctedWith       String?
  customerName        String
  customerId          String?
  customerIdentifier  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  saleItems           SaleItem[]
}

model SaleItem {
  id                  String   @id @default(cuid())
  saleId              String
  productId           String
  quantity            Int
  price               Decimal @db.Decimal(18, 2) // unit price at sale time
  total            Decimal @db.Decimal(18, 2) // price * quantity

  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Expense {
  id            String   @id @default(cuid())
  title         String   // e.g., "Electricity Bill", "Staff Salary"
  description   String?  // optional extra details
  category      ExpenseCategory
  amount        Decimal  @db.Decimal(18,2)
  paymentType   PaymentType   // CASH, CARD, BANK_TRANSFER, etc.
  expenseDate   DateTime @default(now())
  companyId     String
  recordedByEmail  String
  recordedByRole  MainRole
  updatedByEmail     String?
  updatedByRole     MainRole?

  branchId          String?
  branch            Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)


  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ExpenseCategory {
  UTILITIES
  SUPPLIES
  MAINTENANCE
  MARKETING
  TAXES
  OTHER
}

enum PaymentType {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum InvoiceStatus {
  PAID
  UNPAID
}

model Invoice {
  id            String @id @default(cuid())
  invoiceName   String
  totalAmount   Decimal  @db.Decimal(18,2)
  extraCharge   Decimal?  @db.Decimal(18,2)
  extraChargeName String?
  discount      Decimal?  @db.Decimal(18,2)
  discountName String?
  totalTaxAmount     Decimal  @db.Decimal(18,2) @default(0)
  status        InvoiceStatus
  date          DateTime
  dueDate       DateTime
  businessName    String
  email           String
  phone          String
  address         String
  paymentTerm    String?
  customerName    String
  customerEmail   String?
  customerAddress String?
  customerPhone String?
  currency      String
  invoiceNumber Int
  note          String?
  companyId     String
  branchId      String?
  addedBy       String
  addedByRole   MainRole
  editedBy      String?
  editedByRole   MainRole?

  invoiceItems    InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  itemTitle       String
  itemQuantity    Int
  itemAmount      Decimal  @db.Decimal(18,2)
  itemTotal       Decimal  @db.Decimal(18,2)
  tax             Decimal  @db.Decimal(18,2) @default(0)

  invoice         Invoice    @relation(fields: [invoiceId], references: [id])
}

enum SubscriptionPlan {
  FREE
  BASIC
  BUSINESS
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum payingCurrency {
  NGN
  USD
}

model Subscription {
  id         String           @id @default(cuid())
  userId     String           @unique
  companyId  String
  plan       SubscriptionPlan @default(FREE)
  billing    BillingCycle
  active     Boolean          @default(true)
  expiresAt  DateTime

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}


model Payment {
  id         String         @id @default(cuid())
  reference  String         @unique
  plan       SubscriptionPlan
  billing    BillingCycle
  channel    String
  amount     Float
  email      String
  currency   payingCurrency
  status     PaymentStatus

  userId     String
  companyId  String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime       @default(now())
}






